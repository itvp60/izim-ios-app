{
  "expo": {
    "name": "IZIM ID",
    "slug": "izim-id",
    "scheme": "izimid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "backgroundColor": "#0E1F3D",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.izim.id",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "TAG"
        ]
      },
      "infoPlist": {
        "NFCReaderUsageDescription": "Нужен доступ к NFC, чтобы записать профиль на браслет"
      }
    },
    "android": {
      "package": "kz.izim.id",
      "versionCode": 1,
      "permissions": [
        "android.permission.NFC"
      ],
      "backgroundColor": "#0E1F3D",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1F3D"
      }
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Приложение записывает ссылку на профиль в NFC-метку браслета",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужен доступ к фотографиям, чтобы поставить фото на карточку браслета. Оно останется на телефоне.",
          "cameraPermission": "Нужен доступ к камере, чтобы снять фото для карточки браслета. Оно останется на телефоне."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://id.izim.kz",
      "profileSetupPath": "/setup",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1F3D"
    },
    "icon": "./assets/icon.png"
  }
}
